# ==============================================================================
# RK Interior & NEST WALLPAPERS Production Hardened .htaccess
# Security, Performance, Force SSL, SEO Canonicalization & Asset Caching
# ==============================================================================

# 1. DISABLE DIRECTORY BROWSING & SERVER SIGNATURES
Options -Indexes -MultiViews
ServerSignature Off

# 2. BLOCK SENSITIVE & HIDDEN FILES (.env, .git, .json, .lock, .config, .md)
<FilesMatch "^\.|\.(env|git|json|lock|config|mjs|md|log|bak|sql|sh|ps1)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3. FORCE HTTPS REDIRECTION (Port 80 -> Port 443 SSL)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block common malicious query string attacks (SQL Injection, XSS, Path Traversal)
  RewriteCond %{QUERY_STRING} (eval\(|document\.cookie|base64_|javascript:|(\.\./)|boot\.ini|/etc/passwd) [NC,OR]
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (UNION|SELECT|INSERT|UPDATE|DELETE|DROP|DECLARE|EXEC).* [NC]
  RewriteRule .* - [F,L]

  # Block malicious user agents & scraper exploit bots
  RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|curl|scan|sqlmap|nmap|havij) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# 4. ENTERPRISE HTTP SECURITY & HSTS HEADERS
<IfModule mod_headers.c>
  # 2-Year HSTS with preload and subdomains
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
  
  # Prevent Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # Prevent MIME-Sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # XSS Protection
  Header always set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Disable unnecessary device hardware APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  
  # Cross-Origin Policies
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# 5. GZIP / DEFLATE SPEED COMPRESSION (Saves 70-80% bandwidth & super fast loading)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 6. BROWSER CACHING (Instant Repeat Visits & High Performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents - cache for 1 hour
  ExpiresByType text/html "access plus 1 hour"

  # Data / JSON
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media files / Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>
